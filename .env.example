# Public origin used by the browser for API requests.
# Leave empty to call /api/* on the frontend origin. Next.js proxies those
# requests to API_PROXY_TARGET, which keeps auth cookies (including the OAuth
# state cookie) first-party.
NEXT_PUBLIC_API_URL=

# Canonical site URL used for metadata. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only destination for the /api/* rewrite. Do not prefix this with
# NEXT_PUBLIC_ and never expose it to the browser.
API_PROXY_TARGET=http://localhost:5000
